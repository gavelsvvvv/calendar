# Loaded by `next build` and `next start` (NODE_ENV=production).
#
# Committed on purpose. `NEXT_PUBLIC_GA_MEASUREMENT_ID` is a public identifier —
# it is inlined into the client bundle and readable in page source by anyone —
# so keeping it here means a fresh deploy is correctly tagged with no manual
# dashboard step. A real environment variable of the same name still wins over
# this file, so a host (Railway, Vercel, CI) can override or blank it.
#
# Nothing secret belongs in this file. Secrets go in the host's environment,
# where `.gitignore` keeps them out of the repository.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-FC9TGS890K
