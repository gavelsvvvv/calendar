# Google Analytics 4 measurement ID.
#
# Public by design: this value is compiled into the client bundle and is visible
# to anyone who views source. It identifies a destination property, it does not
# authorise anything, so it is not a credential. Never put an API secret or a
# Measurement Protocol secret here — `NEXT_PUBLIC_` inlines the value at build
# time and it would ship to every visitor.
#
# Leave it unset to run without analytics; the tag renders nothing at all.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-FC9TGS890K
